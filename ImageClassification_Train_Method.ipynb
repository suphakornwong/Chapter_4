        "import torch\n",
        "from ultralytics import YOLO\n",
        "\n",
        "model = YOLO('/content/yolo26s-cls.pt')      ## Right-click at Pretraind model (for example, yolo8n.pt) in /content, Select \"copy path\"\n",
        "\n",
        "# ตรวจสอบการใช้งาน GPU อัตโนมัติ (ใช้ device=0 ถ้ามี GPU ถ้าไม่มีจะใช้ device='cpu')\n",
        "device = 0 if torch.cuda.is_available() else 'cpu'\n",
        "print(f\"Using device: {device}\")\n",
        "\n",
        "model.train(\n",
        " data='/content/datasets/Snail_Pest-2',    ## find your datasets folder, Right-click and Select \"copy path\"\n",
        " task='classify',\n",
        " epochs=100,\n",
        " imgsz=640,\n",
        " device=device\n",
        ")"
      ],
